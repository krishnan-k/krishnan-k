{{ 'banner.css' | asset_url | stylesheet_tag }}

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner__section banner--{{ section.settings.image_height }} {% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}"
>
  {%- if section.settings.image != blank -%}
    <div class="customize__banner banner__media media{% if section.settings.image == blank %} placeholder{% endif %}">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        assign sizes = full_width
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          sizes: sizes,
          widths: widths,
          fetchpriority: fetch_priority
      }}
    </div>
  {% else %}
    <div class="customize__banner banner__media media{% if section.settings.image == blank %} placeholder{% endif %}">
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  <div class="banner__content banner__content--{{ section.settings.text_content_position }} page-width {% if section.settings.show_text_background == false %} text_background {% endif %}">
    <div class="banner__box content-container color--{{ section.settings.color_scheme }} gradient text--align--{{ section.settings.text_align }}">
      <div class="">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              <h2 class="banner__heading inline-richtext {{ block.settings.heading_size }}">
                {{ block.settings.heading }}
              </h2>
            {% when 'text' %}
              <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                <p class="decription">{{ block.settings.text }}</p>
              </div>
          {% endcase %}
        {% endfor %}
      </div>

      <div class="">
        {%- if section.settings.button_label != blank -%}
          <div class="banner__buttons">
            <a
              {% if section.settings.button_link %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link" aria-disabled="true"
              {% endif %}
              class="button {% if section.settings.button_style_secondary %}button--secondary{% else %}button--primary{% endif %}"
            >
              {{- section.settings.button_label | escape -}}
              {% render 'icon-right' %}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
 {% if section.settings.bottom_heading != blank %}
    <div class="bottom_banner_content background--{{ section.settings.background }} color--{{ section.settings.text_color }} text--align--center">
      {{ section.settings.bottom_heading }}
    </div>
  {% endif %}

{% schema %}
{
  "name": "t:sections.banner.name",
  "class": "section_banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.banner.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.banner.settings.image_height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.banner.settings.image_height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.banner.settings.image_height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.banner.settings.image_height.options__4.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.banner.settings.image_height.label"
    },
    {
      "type": "header",
      "content": "t:sections.banner.settings.content.content"
    },
    {
      "type": "checkbox",
      "id": "show_text_background",
      "label": "t:sections.banner.settings.show_text_background.label",
      "default" :true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "text_content_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.banner.settings.text_content_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.banner.settings.text_content_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.banner.settings.text_content_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.banner.settings.text_content_position.options__4.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.banner.settings.text_content_position.options__5.label"
        },
        {
          "value": "middle-right",
          "label": "t:sections.banner.settings.text_content_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.banner.settings.text_content_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.banner.settings.text_content_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.banner.settings.text_content_position.options__9.label"
        }
      ],
      "default": "middle-center",
      "label": "t:sections.banner.settings.text_content_position.label"
    },
    {
      "type": "select",
      "id": "text_align",
      "options": [
        {
          "value": "left",
          "label": "t:sections.banner.settings.text_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.banner.settings.text_align.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.banner.settings.text_align.options__3.label"
        },
      ],
      "default": "center",
      "label": "t:sections.banner.settings.text_align.label"
    },
    {
      "type": "header",
      "content": "t:sections.banner.settings.button.content"
    },
    {
    "type": "text",
    "id": "button_label",
    "default": "t:sections.banner.settings.button_label.default",
    "label": "t:sections.banner.settings.button_label.label",
    "info": "t:sections.banner.settings.button_label.info"
  },
  {
    "type": "url",
    "id": "button_link",
    "label": "t:sections.banner.settings.button_link.label"
  },
  {
    "type": "checkbox",
    "id": "button_style_secondary",
    "default": false,
    "label": "t:sections.banner.settings.button_style_secondary.label"
  },
    {
      "type": "header",
      "content": "t:sections.banner.settings.bottom_bar.content"
    },
    {
          "type": "inline_richtext",
          "id": "bottom_heading",
          "label": "t:sections.banner.settings.heading.label",
      "default":"Text here"
        },
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.banner.blocks.heading.name",
      "limit": 1,
      "settings":[
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.banner.blocks.heading.settings.heading.default",
          "label": "t:sections.banner.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.banner.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "t:sections.banner.blocks.text.settings.text.default",
          "label": "t:sections.banner.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.banner.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.banner.blocks.text.settings.text_style.options__2.label"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "t:sections.banner.blocks.text.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.banner.blocks.text.settings.text_style.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
